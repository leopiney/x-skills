# -----------------------------------------------------------------
# All variables below are OPTIONAL.
# The skills work in draft-only mode with nothing set.
# Add a PUBLORA_API_KEY to enable auto-posting tweets and threads.
#
# Where this file is read from (nowhere else):
#   1. ~/.config/x-skills/.env   (or $XDG_CONFIG_HOME/x-skills/.env)
#   2. .env in the installed skill folder
# A .env in your current project or any parent directory is ignored on
# purpose, so a cloned repo cannot swap in someone else's credentials.
# Only the variable names listed in this file are ever loaded.
# -----------------------------------------------------------------

# Publora API key - sign up free at https://app.publora.com/signup?utm_source=github&utm_medium=env-example&utm_campaign=x-skills
PUBLORA_API_KEY=sk_your_key_here

# X (Twitter) platform connection ID (format: twitter-123456789)
# Find this in the Publora dashboard: Channels then your X account.
# Copy the whole thing including the twitter- prefix.
X_PLATFORM_ID=twitter-your_id_here

# -----------------------------------------------------------------
# Apify token (optional) - if you later wire a tweet-reading actor,
# the read-side skills can fetch tweet text instead of asking you to
# paste it. Without a token, hook-extractor and reply-drafter fall
# back to asking you to paste the tweet.
#
# Sign up: https://console.apify.com/sign-up
# Token:   https://console.apify.com/settings/integrations
# -----------------------------------------------------------------
APIFY_TOKEN=apify_api_your_token_here

# ─────────────────────────────────────────────────────────────────
# Pixfaro token (optional) - lets the skills generate illustrations for
# posts (feed images, carousel slides, quote-cards) and attach them on
# publish. Returns a hosted URL that flows straight into Publora media.
# Pixel-exact text/logo overlay keeps every asset on-brand.
#
# Sign up + docs: https://pixfaro.com  (key format: pf_live_...)
#
# Without a token, the skills draft the image prompt and ask you to
# generate it yourself and paste the URL.
# ─────────────────────────────────────────────────────────────────
PIXFARO_TOKEN=pf_live_your_token_here
